# Local-only backend credentials/config. Never place provider keys in mobile/.env or EXPO_PUBLIC_* variables.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Optional extra Gemini keys, tried in order ONLY when a key is rejected (401/403) or over quota (429).
GEMINI_API_KEY_FALLBACK_2=
GEMINI_API_KEY_FALLBACK_3=
# Voice agent interpreter/wording model (default gemini-3.6-flash). Check with: cd backend && python -m scripts.check_gemini
GEMINI_MODEL=gemini-3.6-flash
# Spoken replies (Sarvam Bulbul). Defaults: bulbul:v3 with speaker shubh; falls back once to bulbul:v2/anushka if the account rejects v3.
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
# Set to 0 to run the voice agent on the deterministic Hinglish rules only.
MUNIM_AGENT_LLM=
# Extra web origins allowed by CORS (comma-separated), e.g. an HTTPS tunnel URL for the phone browser.
MUNIM_CORS_ORIGINS=
VITE_API_BASE_URL=http://localhost:8000
# Reserved for a future MongoDB adapter; the demo backend currently uses SQLite.
MONGODB_URI=
