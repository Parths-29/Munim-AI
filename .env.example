# Local-only backend credentials/config. Never place provider keys in mobile/.env or EXPO_PUBLIC_* variables.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Voice agent interpreter model (default gemini-3.8-flash). Check with: cd backend && python -m scripts.check_gemini
GEMINI_MODEL=
# Set to 0 to run the voice agent on the deterministic Hinglish rules only.
MUNIM_AGENT_LLM=
# Extra web origins allowed by CORS (comma-separated), e.g. an HTTPS tunnel URL for the phone browser.
MUNIM_CORS_ORIGINS=
VITE_API_BASE_URL=http://localhost:8000
# Reserved for a future MongoDB adapter; the demo backend currently uses SQLite.
MONGODB_URI=
